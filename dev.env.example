# Malla - Meshtastic Analytics Development Environment Template
#
# Copy this file to .env or dev.env and customize for your environment
# See config.sample.yaml for full configuration options

# PostgreSQL Database Connection
MALLA_DATABASE_FILE=postgresql://user:password@localhost:5432/malla

# MQTT Broker Configuration
MALLA_MQTT_BROKER_ADDRESS=mqtt.meshtastic.org
MALLA_MQTT_PORT=1883
MALLA_MQTT_USERNAME=meshdev
MALLA_MQTT_PASSWORD=large4cats
MALLA_MQTT_TOPIC_PREFIX=msh/US
MALLA_MQTT_TOPIC_SUFFIX=#

# TLS Configuration (optional)
# MALLA_MQTT_TLS_ENABLED=true
# MALLA_MQTT_TLS_CA_CERT=/path/to/ca.crt
# MALLA_MQTT_TLS_CLIENT_CERT=/path/to/client.crt
# MALLA_MQTT_TLS_CLIENT_KEY=/path/to/client.key

# Decryption Keys for Secondary Channels (comma-separated)
# MALLA_DECRYPTION_KEYS=AQ4BzlI/MO1Ed561+X3s1BT4pFjQwPi+qTzBdoef9DU=

# Data Retention (0 = disabled)
MALLA_DATA_RETENTION_HOURS=168
MALLA_DATA_CLEANUP_INTERVAL_SECONDS=3600

# OpenTelemetry / Observability
# MALLA_OTLP_ENDPOINT=http://localhost:4317

# Prometheus Metrics
MALLA_METRICS_ENABLED=true
MALLA_METRICS_PORT=9100

# Web UI Configuration
MALLA_WEB_PORT=5001
MALLA_SECRET_KEY=dev-secret-key-change-in-production

# Logging
MALLA_LOG_LEVEL=INFO

# Multiprocess Prometheus Support (for Gunicorn)
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Development Settings
FLASK_ENV=development
FLASK_DEBUG=1
